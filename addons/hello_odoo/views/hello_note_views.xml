<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hello_note_list" model="ir.ui.view">
        <field name="name">hello.note.list</field>
        <field name="model">hello.note</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_hello_note_form" model="ir.ui.view">
        <field name="name">hello.note.form</field>
        <field name="model">hello.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <field name="body" placeholder="Write something..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hello_note" model="ir.actions.act_window">
        <field name="name">Notes</field>
        <field name="res_model">hello.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hello_root" name="Hello" sequence="90"/>
    <menuitem id="menu_hello_note" name="Notes" parent="menu_hello_root" action="action_hello_note"/>
</odoo>
